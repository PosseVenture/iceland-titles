# ─────────────────────────────────────────────────────────────────────────────
# Icelandic Titles — Environment Variables
# Copy this file to .env.local and fill in real values before going live.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (https://dashboard.stripe.com/test/apikeys) ────────────────────────
# Use pk_test_... / sk_test_... for development
# Switch to pk_live_... / sk_live_... before going live
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ── PayPal (https://developer.paypal.com) ─────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE

# ── Email (Resend — https://resend.com) ───────────────────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE
RESEND_FROM=hello@icelandictitles.com

# ── Analytics (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
